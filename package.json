{
  "name": "zuzo-dialer",
  "version": "0.0.1",
  "private": true,
  "license": "UNLICENSED",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build -w apps/api",
    "build:all": "npm run build -w packages/shared-types && npm run build -w apps/tenant-web && npm run build -w apps/platform-web && npm run build -w apps/api",
    "start:dev": "npm run start:dev -w apps/api",
    "lint": "npm run lint -w apps/api",
    "test": "npm run test -w apps/api",
    "db:generate": "npm run db:generate -w apps/api",
    "db:migrate": "npm run db:migrate -w apps/api",
    "db:studio": "npm run db:studio -w apps/api"
  }
}
